# Start with demo mode; it works without any account.
VITE_AGENT_MODE=demo

# When your ElevenLabs agent is ready:
# VITE_AGENT_MODE=elevenlabs
# VITE_ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxx

# Fastest local test: keep this false and make the ElevenLabs agent public.
VITE_USE_SIGNED_URL=false

# For a private deployed agent, set VITE_USE_SIGNED_URL=true and add these
# as SERVER-SIDE variables in Vercel, not here in the browser env:
# ELEVENLABS_API_KEY=...
# ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxx
